# Copy this file to `.env` and edit the values.

PORT=3000
NODE_ENV=development

# Long random string used to sign session cookies. Change it!
SESSION_SECRET=change-this-to-a-long-random-string
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# ---- Database ----
# mysql (default) or postgres (also run: npm install pg pg-hstore)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aura_apparel
DB_USER=root
DB_PASSWORD=
# Set to true to print every SQL query in the terminal (great for demos)
DB_LOGGING=false

# ---- Display (optional) ----
# Prices are formatted with these. Examples: USD + en-US   |   INR + en-IN
CURRENCY=USD
LOCALE=en-US
