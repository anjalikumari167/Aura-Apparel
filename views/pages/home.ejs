<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="relative h-[70vh] min-h-[460px] bg-neutral-200 overflow-hidden">
  <img src="https://images.unsplash.com/photo-1445205170230-053b83016050?w=1800&q=80" alt=""
       onerror="this.style.display='none'" class="absolute inset-0 w-full h-full object-cover">
  <div class="absolute inset-0 bg-black/35"></div>
  <div class="relative h-full max-w-7xl mx-auto px-6 flex flex-col justify-center text-white">
    <p class="text-xs tracking-[0.4em] mb-4">AUTUMN / WINTER COLLECTION</p>
    <h1 class="font-serif text-5xl sm:text-7xl leading-[1.05] max-w-2xl">Quiet luxury,<br>made for every day.</h1>
    <div class="mt-8 flex gap-4">
      <a href="/shop" class="bg-white text-black px-8 py-3.5 text-sm tracking-widest hover:bg-neutral-200 transition">SHOP THE COLLECTION</a>
      <a href="/shop?sort=rating" class="border border-white px-8 py-3.5 text-sm tracking-widest hover:bg-white hover:text-black transition">TOP RATED</a>
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 mt-20">
  <h2 class="font-serif text-4xl mb-8">Shop by category</h2>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
    <% categories.forEach(function (c) { %>
      <a href="/shop?categories=<%= encodeURIComponent(c.name) %>" class="group block">
        <div class="aspect-square bg-neutral-100 overflow-hidden">
          <img src="<%= c.image %>" alt="<%= c.name %>" loading="lazy" onerror="this.onerror=null;this.src='/img/placeholder.svg'"
               class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
        </div>
        <p class="text-sm tracking-widest mt-3 text-center uppercase"><%= c.name %></p>
      </a>
    <% }) %>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 mt-24">
  <div class="flex items-end justify-between mb-8">
    <h2 class="font-serif text-4xl">New arrivals</h2>
    <a href="/shop?sort=newest" class="text-sm underline underline-offset-4">View all</a>
  </div>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10">
    <% newest.forEach(function (product) { %>
      <%- include('../partials/product-card', { product: product }) %>
    <% }) %>
  </div>
</section>

<% if (sale.length) { %>
<section class="bg-neutral-100 mt-24 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <p class="text-xs tracking-[0.4em] text-neutral-500">LIMITED TIME</p>
      <h2 class="font-serif text-4xl mt-2">On sale now</h2>
      <p class="text-sm text-neutral-600 mt-2">Extra 20% off at checkout with code <strong>INTERN20</strong></p>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10">
      <% sale.forEach(function (product) { %>
        <%- include('../partials/product-card', { product: product }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('../partials/footer') %>
