<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="max-w-md mx-auto px-4 py-16">
  <h1 class="font-serif text-5xl text-center mb-2">Create account</h1>
  <p class="text-center text-sm text-neutral-500 mb-10">Your guest cart will be saved to your account automatically.</p>

  <% if (error) { %><div class="mb-5 border border-red-200 bg-red-50 text-red-700 text-sm px-4 py-3"><%= error %></div><% } %>

  <form action="/signup" method="post" class="space-y-5">
    <input type="hidden" name="next" value="<%= next %>">
    <div>
      <label for="name" class="block text-sm mb-1.5">Full name</label>
      <input id="name" type="text" name="name" value="<%= form.name || '' %>" required autocomplete="name"
             class="w-full border border-neutral-300 px-4 py-3 outline-none focus:border-black">
    </div>
    <div>
      <label for="email" class="block text-sm mb-1.5">Email</label>
      <input id="email" type="email" name="email" value="<%= form.email || '' %>" required autocomplete="email"
             class="w-full border border-neutral-300 px-4 py-3 outline-none focus:border-black">
    </div>
    <div>
      <label for="password" class="block text-sm mb-1.5">Password <span class="text-neutral-400">(min. 6 characters)</span></label>
      <input id="password" type="password" name="password" required minlength="6" autocomplete="new-password"
             class="w-full border border-neutral-300 px-4 py-3 outline-none focus:border-black">
    </div>
    <div>
      <label for="confirm" class="block text-sm mb-1.5">Confirm password</label>
      <input id="confirm" type="password" name="confirm" required minlength="6" autocomplete="new-password"
             class="w-full border border-neutral-300 px-4 py-3 outline-none focus:border-black">
    </div>
    <button type="submit" class="w-full bg-black text-white py-3.5 text-sm tracking-widest hover:bg-neutral-800 transition">CREATE ACCOUNT</button>
  </form>

  <p class="text-center text-sm text-neutral-500 mt-6">Already have an account? <a class="text-black underline underline-offset-4" href="/login<%= next ? '?next=' + encodeURIComponent(next) : '' %>">Log in</a></p>
</div>
<%- include('../partials/footer') %>
