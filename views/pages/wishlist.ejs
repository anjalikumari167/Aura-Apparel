<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
  <h1 class="font-serif text-5xl mb-8">Wishlist</h1>
  <% if (!products.length) { %>
    <div id="wishlist-empty" class="text-center py-20 border border-dashed border-neutral-300">
      <p class="font-serif text-3xl mb-2">Nothing saved yet</p>
      <p class="text-sm text-neutral-500 mb-6">Tap the heart on any product to save it here.</p>
      <a href="/shop" class="inline-block bg-black text-white px-8 py-3.5 text-sm tracking-widest hover:bg-neutral-800 transition">BROWSE THE SHOP</a>
    </div>
  <% } else { %>
    <div id="wishlist-grid" class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10">
      <% products.forEach(function (product) { %>
        <%- include('../partials/product-card', { product: product }) %>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
