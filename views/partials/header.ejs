<div class="bg-black text-white text-center text-xs tracking-widest py-2 px-4">
  FREE SHIPPING ON ALL ORDERS &nbsp;·&nbsp; USE CODE <strong>INTERN20</strong> FOR 20% OFF
</div>
<header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-neutral-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <a href="/" class="font-serif text-2xl tracking-[0.25em] font-semibold">AURA</a>

    <nav class="hidden md:flex items-center gap-8 text-sm">
      <a href="/shop" class="hover:underline underline-offset-4">Shop</a>
      <a href="/shop?categories=Tops" class="hover:underline underline-offset-4">Tops</a>
      <a href="/shop?categories=Dresses" class="hover:underline underline-offset-4">Dresses</a>
      <a href="/shop?categories=Outerwear" class="hover:underline underline-offset-4">Outerwear</a>
      <a href="/shop?categories=Knitwear" class="hover:underline underline-offset-4">Knitwear</a>
    </nav>

    <div class="flex items-center gap-3 sm:gap-4">
      <form action="/shop" method="get" class="hidden lg:block">
        <input type="search" name="search" placeholder="Search" aria-label="Search products"
               class="border-b border-neutral-300 focus:border-black outline-none text-sm py-1 w-36 focus:w-48 transition-all bg-transparent">
      </form>

      <a href="/wishlist" class="p-1 hover:opacity-60" aria-label="Wishlist">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s-7-4.6-9.5-9A5.5 5.5 0 0 1 12 6.6 5.5 5.5 0 0 1 21.5 12C19 16.4 12 21 12 21z"/></svg>
      </a>

      <% if (currentUser) { %>
        <details class="relative">
          <summary class="list-none cursor-pointer p-1 hover:opacity-60 flex items-center gap-1 text-sm" aria-label="Account">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
            <span class="hidden sm:inline max-w-[90px] truncate"><%= currentUser.name.split(' ')[0] %></span>
          </summary>
          <div class="absolute right-0 mt-3 w-48 bg-white border border-neutral-200 shadow-lg text-sm z-40">
            <a href="/orders" class="block px-4 py-2.5 hover:bg-neutral-50">My Orders</a>
            <a href="/wishlist" class="block px-4 py-2.5 hover:bg-neutral-50">Wishlist</a>
            <a href="/account" class="block px-4 py-2.5 hover:bg-neutral-50">Saved Address</a>
            <% if (currentUser.role === 'admin') { %>
              <a href="/admin" class="block px-4 py-2.5 hover:bg-neutral-50 font-medium">Admin Panel</a>
            <% } %>
            <form action="/logout" method="post" class="border-t border-neutral-200">
              <button type="submit" class="w-full text-left px-4 py-2.5 hover:bg-neutral-50">Log out</button>
            </form>
          </div>
        </details>
      <% } else { %>
        <a href="/login" class="text-sm hover:underline underline-offset-4">Log in</a>
      <% } %>

      <button type="button" id="open-cart" class="relative p-1 hover:opacity-60" aria-label="Open cart">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span data-cart-count class="absolute -top-1.5 -right-2 min-w-[18px] h-[18px] px-1 rounded-full bg-black text-white text-[10px] leading-[18px] text-center <%= cartCount ? '' : 'hidden' %>"><%= cartCount %></span>
      </button>
    </div>
  </div>
</header>
<main class="flex-1">
