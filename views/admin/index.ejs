<%- include('../partials/head', { title: 'Admin' }) %>
<%- include('../partials/header') %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <div>
      <p class="text-xs tracking-[0.3em] text-neutral-500">ADMIN PANEL</p>
      <h1 class="font-serif text-5xl">Dashboard</h1>
    </div>
    <div class="flex gap-2 text-sm" role="tablist">
      <button type="button" data-tab="overview" class="tab-btn">Overview</button>
      <button type="button" data-tab="products" class="tab-btn">Products</button>
      <button type="button" data-tab="orders" class="tab-btn">Orders</button>
    </div>
  </div>

  <!-- ================= OVERVIEW ================= -->
  <section data-panel="overview" class="hidden">
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
      <% [['Revenue', money(stats.revenue)], ['Orders', stats.orders], ['Pending', stats.pending], ['Products', stats.products], ['Low stock (≤5)', stats.lowStock]].forEach(function (s) { %>
        <div class="border border-neutral-200 p-5">
          <p class="text-xs text-neutral-500 tracking-wide uppercase"><%= s[0] %></p>
          <p class="font-serif text-4xl mt-1"><%= s[1] %></p>
        </div>
      <% }) %>
    </div>
    <p class="text-sm text-neutral-500 mt-6">Use the tabs above to add products and update order statuses. Revenue excludes cancelled orders.</p>
  </section>

  <!-- ================= PRODUCTS ================= -->
  <section data-panel="products" class="hidden">
    <div class="grid lg:grid-cols-[380px_1fr] gap-10">
      <form id="product-form" class="space-y-4 text-sm border border-neutral-200 p-5 h-fit" novalidate>
        <h2 class="font-serif text-2xl">Add a product</h2>
        <div><label class="block mb-1" for="p-name">Name *</label><input id="p-name" name="name" class="field" required></div>
        <div><label class="block mb-1" for="p-desc">Description</label><textarea id="p-desc" name="description" rows="3" class="field"></textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block mb-1" for="p-price">Price *</label><input id="p-price" name="price" type="number" min="0" step="0.01" class="field" required></div>
          <div><label class="block mb-1" for="p-disc">Discount price</label><input id="p-disc" name="discountPrice" type="number" min="0" step="0.01" class="field"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block mb-1" for="p-cat">Category *</label><input id="p-cat" name="category" list="cat-list" class="field" required>
            <datalist id="cat-list"><% Array.from(new Set(products.map(function (p) { return p.category; }))).forEach(function (c) { %><option value="<%= c %>"><% }) %></datalist></div>
          <div><label class="block mb-1" for="p-stock">Stock *</label><input id="p-stock" name="stockCount" type="number" min="0" value="10" class="field" required></div>
        </div>
        <div><label class="block mb-1" for="p-sizes">Sizes <span class="text-neutral-400">(comma separated)</span></label><input id="p-sizes" name="sizes" placeholder="S, M, L, XL" class="field"></div>
        <div><label class="block mb-1" for="p-colors">Colors <span class="text-neutral-400">(comma separated)</span></label><input id="p-colors" name="colors" placeholder="Black, White" class="field"></div>
        <div><label class="block mb-1" for="p-images">Image URLs * <span class="text-neutral-400">(one per line)</span></label>
          <textarea id="p-images" name="images" rows="3" placeholder="https://images.unsplash.com/photo-...?w=900" class="field"></textarea></div>
        <div><label class="block mb-1" for="p-rating">Rating (0–5)</label><input id="p-rating" name="rating" type="number" min="0" max="5" step="0.1" value="4.5" class="field"></div>
        <button type="submit" class="w-full bg-black text-white py-3 tracking-widest hover:bg-neutral-800 transition disabled:opacity-60">ADD PRODUCT</button>
      </form>

      <div class="overflow-x-auto border border-neutral-200 h-fit">
        <table class="w-full text-sm">
          <thead class="bg-neutral-50 text-left text-xs uppercase tracking-wide text-neutral-500">
            <tr><th class="p-3">Product</th><th class="p-3">Price</th><th class="p-3">Stock</th><th class="p-3"></th></tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            <% products.forEach(function (p) { %>
              <tr data-product-row="<%= p.id %>">
                <td class="p-3">
                  <div class="flex items-center gap-3">
                    <img src="<%= p.images[0] %>" alt="" onerror="this.onerror=null;this.src='/img/placeholder.svg'" class="w-10 h-12 object-cover bg-neutral-100">
                    <div><a href="/product/<%= p.id %>" class="hover:underline"><%= p.name %></a><p class="text-xs text-neutral-500"><%= p.category %></p></div>
                  </div>
                </td>
                <td class="p-3 whitespace-nowrap"><%= money(p.effectivePrice) %><% if (p.discountPrice !== null) { %> <span class="text-xs text-neutral-400 line-through"><%= money(p.price) %></span><% } %></td>
                <td class="p-3">
                  <div class="flex items-center gap-2">
                    <input type="number" min="0" value="<%= p.stockCount %>" data-stock-input="<%= p.id %>" aria-label="Stock for <%= p.name %>"
                           class="w-16 border border-neutral-300 px-2 py-1 <%= p.stockCount <= 5 ? 'text-red-600' : '' %>">
                    <button type="button" data-stock-save="<%= p.id %>" class="text-xs underline underline-offset-2">Save</button>
                  </div>
                </td>
                <td class="p-3 text-right"><button type="button" data-delete-product="<%= p.id %>" data-name="<%= p.name %>" class="text-xs text-red-600 hover:underline">Delete</button></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= ORDERS ================= -->
  <section data-panel="orders" class="hidden">
    <% if (!orders.length) { %>
      <p class="text-center text-neutral-500 py-16 border border-dashed border-neutral-300">No orders have been placed yet.</p>
    <% } else { %>
      <div class="space-y-5">
        <% orders.forEach(function (o) { %>
          <article class="border border-neutral-200">
            <header class="flex flex-wrap items-center justify-between gap-4 bg-neutral-50 px-5 py-4 text-sm">
              <div class="flex flex-wrap gap-x-8 gap-y-1">
                <div><p class="text-xs text-neutral-500">ORDER</p><p class="font-medium">#<%= o.id %></p></div>
                <div><p class="text-xs text-neutral-500">CUSTOMER</p><p><%= o.customer ? o.customer.name : 'Unknown' %> <span class="text-neutral-400"><%= o.customer ? o.customer.email : '' %></span></p></div>
                <div><p class="text-xs text-neutral-500">PLACED</p><p><%= fmtDate(o.createdAt) %></p></div>
                <div><p class="text-xs text-neutral-500">TOTAL</p><p class="font-medium"><%= money(o.totalAmount) %></p></div>
              </div>
              <div class="flex items-center gap-3">
                <span data-status-badge="<%= o.id %>" class="px-3 py-1 text-xs font-medium rounded-full <%= statusClass[o.status] || 'bg-neutral-100' %>"><%= o.status %></span>
                <% if (o.status === 'Cancelled') { %>
                  <span class="text-xs text-neutral-400">Cancelled</span>
                <% } else { %>
                  <select data-order-status="<%= o.id %>" aria-label="Update status for order <%= o.id %>" class="border border-neutral-300 bg-white px-2 py-1.5 text-sm">
                    <% statuses.forEach(function (s) { %><option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
                  </select>
                <% } %>
              </div>
            </header>
            <div class="px-5 py-3 text-sm">
              <% o.items.forEach(function (i) { %>
                <p class="py-0.5"><%= i.quantity %> × <%= i.productName %> <span class="text-neutral-500 text-xs"><%= [i.size, i.color].filter(Boolean).join(' · ') %></span> — <%= money(i.lineTotal) %></p>
              <% }) %>
              <p class="text-xs text-neutral-500 mt-2">
                Ship to: <%= o.shippingAddress.name %>, <%= o.shippingAddress.line1 %>, <%= o.shippingAddress.city %>, <%= o.shippingAddress.state %> <%= o.shippingAddress.postalCode %> · <%= o.paymentMethod %>
                <% if (o.promoCode) { %> · Promo <%= o.promoCode %> (−<%= money(o.discountApplied) %>)<% } %>
              </p>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>
<%- include('../partials/footer', { scripts: ['/js/admin.js'] }) %>
